<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LOCALAGENT // CONTROL PLANE"
        android:textColor="#00E5FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNoticeBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#332196F3"
        android:padding="8dp"
        android:text="PHASE 0 FOUNDATION ACTIVE: Autonomous features are disabled."
        android:textColor="#90CAF9"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvAgentStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Agent Status: IDLE"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvExecutionState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Execution State: IDLE"
        android:textColor="#AAAAAA"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvSafetyStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Safety Status: SAFE"
        android:textColor="#66BB6A"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvAccessibilityStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Accessibility Service: NOT ENABLED"
        android:textColor="#EF5350"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnEnableAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Configure Accessibility Service" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStartPlaceholder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:enabled="false"
            android:text="START" />

        <Button
            android:id="@+id/btnStopPlaceholder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:enabled="false"
            android:text="STOP" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Activity Log:"
        android:textColor="#00E5FF"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="#1E1E1E"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLogArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[SYSTEM] Phase 0 LocalAgent initialized."
            android:textColor="#00FF66"
            android:typeface="monospace"
            android:textSize="12sp" />
    </ScrollView>

</LinearLayout>
