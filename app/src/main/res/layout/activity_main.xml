<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#121212">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LOCALAGENT"
        android:textColor="#00E5FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- TAB NAVIGATION BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTabDashboard"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:textSize="10sp"
            android:text="DASHBOARD" />

        <Button
            android:id="@+id/btnTabPermissions"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:textSize="10sp"
            android:text="PERMISSIONS" />

        <Button
            android:id="@+id/btnTabDiagnostics"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:textSize="10sp"
            android:text="DIAGNOSTICS" />

        <Button
            android:id="@+id/btnTabConsole"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:textSize="10sp"
            android:text="CONSOLE" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========================================================= -->
            <!-- TAB 1: OPERATIONAL DASHBOARD                              -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/panelDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- FOUNDATION READINESS HEADER CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1E272C"
                    android:padding="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDashboardBanner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● FOUNDATION READY"
                        android:textColor="#66BB6A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDashboardSubtext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="82/82 foundation tests passed | 53/53 commands implemented"
                        android:textColor="#B0BEC5"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- STATUS BADGES CARD -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="AGENT STATUS"
                    android:textColor="#FFD54F"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#1C2833"
                    android:padding="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAgentStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Agent Status: IDLE"
                        android:textColor="#80D8FF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvExecutionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Execution Controller: IDLE"
                        android:textColor="#A5D6A7"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvSafetyBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Safety Status: SAFE_IDLE"
                        android:textColor="#66BB6A"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvAccessibilityBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Accessibility Service: ENABLED"
                        android:textColor="#66BB6A"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- VOICE SERVICES CARD -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="VOICE SPEECH CONTROLS"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTestTtsSpeak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="TEST SPEAK" />

                    <Button
                        android:id="@+id/btnTestSttListen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="TEST LISTEN" />
                </LinearLayout>

                <!-- QUICK ACTIONS CARD -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="QUICK SETTINGS ACTIONS"
                    android:textColor="#FFD54F"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnQuickAccessibility"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="2dp"
                        android:textSize="10sp"
                        android:text="ACCESSIBILITY" />

                    <Button
                        android:id="@+id/btnQuickWriteSettings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:textSize="10sp"
                        android:text="WRITE SETTINGS" />

                    <Button
                        android:id="@+id/btnQuickNotifPolicy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:textSize="10sp"
                        android:text="DND POLICY" />
                </LinearLayout>

                <!-- TEST RUNNER QUICK ACCESSIBLE CARD -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="FOUNDATION TEST HARNESS"
                    android:textColor="#FFD54F"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#1E272C"
                    android:padding="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRunnerProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Progress: 0 / 82 completed"
                        android:textColor="#FFD54F"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTestIndex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Test: 1 / 82"
                        android:textColor="#00E5FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTestName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Execution State Transitions"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTestCommand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="#121212"
                        android:padding="4dp"
                        android:text="calculate 12 + 34"
                        android:textColor="#80D8FF"
                        android:typeface="monospace"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTestExpected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="#121212"
                        android:padding="4dp"
                        android:text="Result: 46"
                        android:textColor="#A5D6A7"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTestStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Status: PENDING"
                        android:textColor="#FFCC80"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etObservedResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="#121212"
                        android:hint="Notes / physical observation..."
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666"
                        android:padding="4dp"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etTestError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="#121212"
                        android:hint="Error details..."
                        android:textColor="#FF8A80"
                        android:textColorHint="#666666"
                        android:padding="4dp"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTestDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Duration: - ms"
                        android:textColor="#B0BEC5"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvTestEvidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Evidence: NONE"
                        android:textColor="#B0BEC5"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnExecuteTest"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="2dp"
                            android:text="EXECUTE" />

                        <Button
                            android:id="@+id/btnCaptureEvidence"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="2dp"
                            android:text="EVIDENCE" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnMarkPass"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PASS" />

                        <Button
                            android:id="@+id/btnMarkFail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="FAIL" />

                        <Button
                            android:id="@+id/btnMarkBlocked"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="BLOCKED" />

                        <Button
                            android:id="@+id/btnMarkSkip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SKIP" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnPrevTest"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PREV" />

                        <Button
                            android:id="@+id/btnNextTest"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="NEXT" />

                        <Button
                            android:id="@+id/btnClearTestResult"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="CLEAR" />

                        <Button
                            android:id="@+id/btnClearAllTestResults"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="CLEAR ALL" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnRunAutomatedBatch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="RUN ALL AUTOMATED TESTS" />
                </LinearLayout>

            </LinearLayout>

            <!-- ========================================================= -->
            <!-- TAB 2: PERMISSIONS & CAPABILITIES PANEL                   -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/panelPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PERMISSIONS &amp; CAPABILITIES"
                    android:textColor="#FFD54F"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- RUNTIME PERMISSIONS CARD -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="RUNTIME PERMISSIONS"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRuntimePermDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#1C2833"
                    android:padding="8dp"
                    android:textColor="#ECEFF1"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnGrantRuntimePerms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Request Runtime Permissions (Storage, Camera, Audio, Location, Phone State)" />

                <!-- SPECIAL ACCESS CARD -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="SPECIAL ACCESS &amp; SETTINGS"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSpecialAccessDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#1C2833"
                    android:padding="8dp"
                    android:textColor="#ECEFF1"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnOpenAccessibilitySettings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="2dp"
                        android:textSize="10sp"
                        android:text="ACCESSIBILITY" />

                    <Button
                        android:id="@+id/btnOpenWriteSettings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:textSize="10sp"
                        android:text="WRITE SETTINGS" />

                    <Button
                        android:id="@+id/btnOpenNotificationPolicy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:textSize="10sp"
                        android:text="DND POLICY" />
                </LinearLayout>

                <!-- DEVICE CAPABILITIES CARD -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="DEVICE CAPABILITIES &amp; SENSORS"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCapabilitiesCategorizedDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#1C2833"
                    android:padding="8dp"
                    android:textColor="#ECEFF1"
                    android:typeface="monospace"
                    android:textSize="11sp" />

                <!-- SYSTEM SERVICES CARD -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="SYSTEM SERVICES (STT / TTS)"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSpeechServicesDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#1C2833"
                    android:padding="8dp"
                    android:textColor="#ECEFF1"
                    android:textSize="11sp" />

                <!-- SYSTEM / PRIVILEGED CLASSIFICATION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="SYSTEM / PRIVILEGED CLASSIFICATION"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFutureCapabilitiesDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#1A1A1A"
                    android:padding="8dp"
                    android:text="- Device Owner Privileges: SYSTEM_ONLY (Provisioning required)\n- Direct Bluetooth Toggle: OS_RESTRICTED (Launches Settings)\n- Camera Automation / OCR: Planned for Phase 3"
                    android:textColor="#777777"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- ========================================================= -->
            <!-- TAB 3: FOUNDATION DIAGNOSTICS & READINESS PANEL           -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/panelDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FOUNDATION STATUS &amp; DIAGNOSTICS"
                    android:textColor="#FFD54F"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReadinessOverallBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#3300E5FF"
                    android:padding="10dp"
                    android:text="READINESS STATUS: EVALUATING..."
                    android:textColor="#00E5FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnEvaluateReadiness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="RE-EVALUATE FOUNDATION READINESS" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="SYSTEM &amp; ENVIRONMENT INFORMATION"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSystemInfoDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#1C2833"
                    android:padding="8dp"
                    android:textColor="#A3E4D7"
                    android:typeface="monospace"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnRunFullDiagnostics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="RUN HARDWARE DIAGNOSTICS" />

                <TextView
                    android:id="@+id/tvFullDiagnosticsDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#1C2833"
                    android:padding="8dp"
                    android:text="Diagnostics not run."
                    android:textColor="#A3E4D7"
                    android:typeface="monospace"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- ========================================================= -->
            <!-- TAB 4: CONSOLE & HARNESS PANEL                            -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/panelConsole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvAgentStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Agent Status: IDLE"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvExecutionState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Execution State: IDLE"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvSafetyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Safety Status: SAFE_IDLE"
                    android:textColor="#66BB6A"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvAccessibilityStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Accessibility Service: NOT ENABLED"
                    android:textColor="#EF5350"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnEnableAccessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Configure Accessibility Service" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="LIVE COMMAND TEST CONSOLE"
                    android:textColor="#00E5FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etLiveCommand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="Enter command (e.g. brightness 80)"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#777777"
                    android:background="#222222"
                    android:padding="10dp"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnExecuteLiveCommand"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="EXECUTE" />

                    <Button
                        android:id="@+id/btnTestConcurrency"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:text="Test Concurrency" />

                    <Button
                        android:id="@+id/btnClearConsole"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="CLEAR" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLiveConsoleDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#1B2631"
                    android:padding="10dp"
                    android:text="COMMAND: -\nOPERATION: -\nCONTROLLER: -\nSTATUS: IDLE\nVERIFICATION: -\nDURATION: - ms"
                    android:textColor="#A3E4D7"
                    android:typeface="monospace"
                    android:textSize="12sp" />

                <!-- APP LAUNCH TEST PANEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="SAFE APP LAUNCH TEST"
                    android:textColor="#CE93D8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAppLaunchQuery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="Enter app name (e.g., Settings)"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#777777"
                    android:background="#222222"
                    android:padding="10dp"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnValidateApp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="VALIDATE APP" />

                    <Button
                        android:id="@+id/btnLaunchApp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="LAUNCH APP" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAppLaunchDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#2A1B2D"
                    android:padding="8dp"
                    android:text="Requested: -\nResolved: -\nPackage: -\nActivity: -\nStatus: IDLE\nDuration: - ms"
                    android:textColor="#E1BEE7"
                    android:typeface="monospace"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Activity Log:"
                    android:textColor="#00E5FF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvLogArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#1E1E1E"
                    android:padding="8dp"
                    android:text="[SYSTEM] Phase 2.5 LocalAgent active."
                    android:textColor="#00FF66"
                    android:typeface="monospace"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
