<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LOCALAGENT // CONTROL PLANE"
        android:textColor="#00E5FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNoticeBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#332196F3"
        android:padding="8dp"
        android:text="PHASE 0, 1, 2.2 &amp; 2.3 ACTIVE: Hardened Core &amp; System Controls Operational."
        android:textColor="#90CAF9"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAgentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Agent Status: IDLE"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvExecutionState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Execution State: IDLE"
                android:textColor="#AAAAAA"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSafetyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Safety Status: SAFE_IDLE"
                android:textColor="#66BB6A"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAccessibilityStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Accessibility Service: NOT ENABLED"
                android:textColor="#EF5350"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnEnableAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Configure Accessibility Service" />

            <!-- DEVICE CAPABILITIES REGISTRY DISPLAY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="DEVICE CAPABILITIES REGISTRY"
                android:textColor="#FFD54F"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCapabilityRegistryDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#263238"
                android:padding="8dp"
                android:text="Capability registry loading..."
                android:textColor="#ECEFF1"
                android:typeface="monospace"
                android:textSize="11sp" />

            <!-- APP LAUNCH TEST PANEL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="PHASE 2.2 — SAFE APP LAUNCH TEST"
                android:textColor="#CE93D8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAppLaunchQuery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Enter app name or package (e.g., Settings)"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:background="#222222"
                android:padding="10dp"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnValidateApp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="VALIDATE APP" />

                <Button
                    android:id="@+id/btnLaunchApp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="LAUNCH APP" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAppLaunchDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#2A1B2D"
                android:padding="8dp"
                android:text="Requested: -\nResolved: -\nPackage: -\nActivity: -\nStatus: IDLE\nDuration: - ms"
                android:textColor="#E1BEE7"
                android:typeface="monospace"
                android:textSize="11sp" />

            <!-- FIRST-RUN RUNTIME PERMISSIONS SETUP -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="FIRST-RUN PERMISSION SETUP"
                android:textColor="#FFB74D"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPermissionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#263238"
                android:padding="8dp"
                android:text="Storage Permission (Notes): CHECKING...\nCamera Permission (Torch): CHECKING..."
                android:textColor="#ECEFF1"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRequestPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Grant Required Runtime Permissions" />

            <!-- DEVICE DIAGNOSTICS SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="DEVICE DIAGNOSTICS"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRunDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="RUN DEVICE DIAGNOSTICS" />

            <TextView
                android:id="@+id/tvDiagnosticsDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#1C2833"
                android:padding="8dp"
                android:text="Diagnostics report not run."
                android:textColor="#A3E4D7"
                android:typeface="monospace"
                android:textSize="11sp" />

            <!-- LIVE COMMAND TEST CONSOLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="LIVE COMMAND TEST CONSOLE"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etLiveCommand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Enter command (e.g. brightness 80)"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:background="#222222"
                android:padding="10dp"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnExecuteLiveCommand"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="EXECUTE" />

                <Button
                    android:id="@+id/btnTestConcurrency"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:text="Test Concurrency" />

                <Button
                    android:id="@+id/btnClearConsole"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="CLEAR" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLiveConsoleDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#1B2631"
                android:padding="10dp"
                android:text="COMMAND: -\nOPERATION: -\nCONTROLLER: -\nSTATUS: IDLE\nVERIFICATION: -\nDURATION: - ms"
                android:textColor="#A3E4D7"
                android:typeface="monospace"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="RECENT EXECUTION HISTORY (MAX 20):"
                android:textColor="#FFD54F"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExecutionHistoryLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#1C2833"
                android:padding="8dp"
                android:text="No recent executions."
                android:textColor="#F5B041"
                android:typeface="monospace"
                android:textSize="11sp" />

            <!-- PHASE 1 SAFETY HARNESS PANEL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="PHASE 1 — SAFETY HARNESS TEST PANEL"
                android:textColor="#FFD54F"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSuiteSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Suite Status: NOT RUN (Passed: 0, Failed: 0, Total: 0)"
                android:textColor="#E0E0E0"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRunAllTests"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Run All Phase 1 Tests" />

                <Button
                    android:id="@+id/btnClearResults"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Clear Results" />
            </LinearLayout>

            <!-- HARDWARE VERIFICATION STATUS SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="HARDWARE VERIFICATION"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHardwareVerificationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#263238"
                android:padding="8dp"
                android:text="Volume-Up Double Press: [ NOT VERIFIED ]\nPhysical Flashlight/Haptics/Sensors: [ MANUAL DEVICE TEST REQUIRED ]"
                android:textColor="#FFB74D"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Harness &amp; Activity Log:"
                android:textColor="#00E5FF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvLogArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#1E1E1E"
                android:padding="8dp"
                android:text="[SYSTEM] Phase 2.3 LocalAgent active."
                android:textColor="#00FF66"
                android:typeface="monospace"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
